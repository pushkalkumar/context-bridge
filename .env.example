# context-bridge configuration
# Copy to ~/.context-bridge/.env and fill in the values you want.
# All variables are optional — the rule-based planner works with none of them.

# ── LLM planning (Tier 1: Anthropic) ─────────────────────────────────────────
# Enables context-aware replanning with confidence scores and alternative approaches.
ANTHROPIC_API_KEY=

# ── LLM planning (Tier 2: Ollama) ────────────────────────────────────────────
# If Anthropic is unavailable, Ollama is tried next. Auto-detected at localhost:11434.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:7b

# ── Semantic search ───────────────────────────────────────────────────────────
# Voyage AI key for embedding-based cross-project similarity search.
# Tried before ANTHROPIC_API_KEY. Requires: pip install "claude-context-bridge[semantic]"
# VOYAGE_API_KEY=

# ── Planner model ─────────────────────────────────────────────────────────────
# PLANNER_MODEL=claude-sonnet-4-6

# ── Storage ───────────────────────────────────────────────────────────────────
# DB_PATH=~/.context-bridge/checkpoints.db
# SERVER_PORT=7723
